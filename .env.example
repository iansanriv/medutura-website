# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to enter /admin
ADMIN_EMAILS=owner@example.com

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
ATH_MOVIL_BUSINESS=/medutura

# Store totals. Keep zero until the owner confirms the correct amounts.
SHIPPING_FLAT_RATE_CENTS=0
SALES_TAX_RATE=0

# Optional order emails through Resend
RESEND_API_KEY=
FROM_EMAIL=Medutura <orders@yourdomain.com>
ORDER_NOTIFICATION_EMAIL=owner@example.com
